//SELECTION SORT 
#include <iostream>
#include <vector>
using namespace std;
class Solution {
public:
    void swap(int &a,int &b){
        int temp=a;
        a=b;
        b=temp;
    }
    vector<int> selectionSort(vector<int>& nums) {
        int n=nums.size();
        for(int i=0;i<=n-2;i++){
            int min=i;
            for(int j=i;j<=n-1;j++){
                if(nums[min]>nums[j]){
                    min=j;
                }
            }
            swap(nums[i],nums[min]);
        }
        return nums;
    }
};
int main() {
    Solution obj;

    vector<int> nums = {64, 25, 12, 22, 11};

    vector<int> sorted = obj.selectionSort(nums);

    cout << "Sorted Array: ";
    for (int x : sorted) {
        cout << x << " ";
    }

    return 0;
}
